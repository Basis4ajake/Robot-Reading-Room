# Local Knowledge Library configuration
# Copy this file to .env and fill in values for your environment.

# Directory where libraries are stored. Must be excluded from git.
LKL_DATA_DIR=./data/libraries

# Ollama model name for generation (optional local provider)
LKL_OLLAMA_MODEL=qwen-b

# Ollama embedding model name (optional local provider)
LKL_EMBEDDING_MODEL=mpt-7b-instruct

# Debug mode enables pipeline logging.
LKL_DEBUG=false

# API server bind address (defaults to localhost-only).
LKL_API_HOST=127.0.0.1
LKL_API_PORT=8000

# Force the dummy embedder/LLM even if Ollama is available (useful for testing).
LKL_FORCE_DUMMY=false
